// Re-RedScript (RRS) Grammar
// Syntax: Lark EBNF

start: (statement | _NEWLINE)+

statement: module_def
         | func_def
         | for_loop
         | while_loop
         | if_stmt
         | assignment
         | aug_assignment
         | import_stmt
         | from_import_stmt
         | return_stmt
         | simulate_stmt
         | instruction
         | assert_stmt

// Assert
assert_stmt: "assert" expression [_COMMA expression] _NEWLINE

// Simulate with callback - uses Python-style indentation
simulate_stmt: "Simulate" _LPAR _LPAR CNAME [_COMMA expression] _RPAR _RPAR _COLON suite

// Module Definition (with optional trigger block)
module_def: "module" CNAME _LPAR [params] _RPAR _COLON suite

// Trigger block within module
trigger_block: "trigger" _COLON suite

// Function Definition
func_def: "def" CNAME _LPAR [params] _RPAR _COLON suite

// For Loop
for_loop: "for" CNAME "in" expression _COLON suite

// While Loop
while_loop: "while" expression _COLON suite

// If/Elif/Else
if_stmt: "if" expression _COLON suite elif_clause* [else_clause]
elif_clause: "elif" expression _COLON suite
else_clause: "else" _COLON suite

// Assignment
assignment: CNAME _EQUALS expression _NEWLINE
           | atom _LSQB expression _RSQB _EQUALS expression _NEWLINE -> index_assignment
aug_assignment: CNAME _PLUSEQ expression _NEWLINE

// Imports
import_stmt: "import" CNAME ["as" CNAME] _NEWLINE
from_import_stmt: "from" CNAME "import" CNAME (_COMMA CNAME)* _NEWLINE

// Return
return_stmt: "return" [expression] _NEWLINE

params: CNAME (_COMMA CNAME)*

suite: _NEWLINE _INDENT statement+ _DEDENT

// Instructions (Expression statements)
instruction: expression _NEWLINE

// Function Call (now an expression)
function_call: CNAME _LPAR [arguments] _RPAR

arguments: arg (_COMMA arg)*

arg: expression             -> positional_arg
   | CNAME _EQUALS expression   -> keyword_arg

// Expressions
?expression: or_test

?or_test: and_test
        | or_test "or" and_test -> or_expr

?and_test: not_test
         | and_test "and" not_test -> and_expr

?not_test: comparison
         | "not" not_test -> not_expr
         | comparison

?comparison: sum
           | sum "==" sum -> eq
           | sum "!=" sum -> ne
           | sum "<" sum -> lt
           | sum ">" sum -> gt
           | sum "<=" sum -> le
           | sum ">=" sum -> ge

?sum: product
    | sum "+" product   -> add
    | sum "-" product   -> sub

?product: unary
        | product "*" unary  -> mul
        | product "/" unary  -> div

?unary: atom
      | "-" unary -> neg
      | "+" unary -> pos

?atom: NUMBER           -> number
     | ESCAPED_STRING   -> string
     | function_call
     | atom _LSQB expression _RSQB -> index_expr
     | atom "." CNAME _LPAR [arguments] _RPAR -> method_call
     | atom "." CNAME   -> getattr
     | CNAME            -> var
     | "[" [expression (_COMMA expression)*] "]" -> list_expr
     | _LPAR expression _RPAR
     | _LPAR expression (_COMMA expression)+ _RPAR -> tuple

// Terminals
%import common.CNAME
%import common.NUMBER
%import common.ESCAPED_STRING

// Named terminals for Indenter
_LPAR: "("
_RPAR: ")"
_LSQB: "["
_RSQB: "]"
_COMMA: ","
_COLON: ":"
_EQUALS: "="
_PLUSEQ: "+="

// Custom WS that does not consume newlines
WS: /[ \t\f]+/
%ignore WS

// Comments - ignored at lexer level
COMMENT: /#[^\n]*/
%ignore COMMENT

// Newline includes optional trailing comment before the actual newline
// This allows comments on same line as code and comment-only lines in blocks
_NEWLINE: /(\r?\n[\t ]*(#[^\n]*)?)+/
%declare _INDENT _DEDENT