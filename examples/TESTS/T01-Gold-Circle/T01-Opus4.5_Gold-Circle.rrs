# T01-Opus4.5_Gold-Circle.rrs
# A grand gold circle with an intricate black floral pattern
# Radius: 50 blocks, 2 layers (solid base + stained glass top)

module GoldCircleWithFloralPattern(radius):
    # Multiple random yellow/gold blocks for the base circle
    gold_blocks = [
        "minecraft:gold_block",
        "minecraft:yellow_wool",
        "minecraft:yellow_concrete",
        "minecraft:yellow_terracotta",
        "minecraft:raw_gold_block",
        "minecraft:yellow_glazed_terracotta",
        "minecraft:hay_block"
    ]
    
    # Multiple random black blocks for the floral pattern
    black_blocks = [
        "minecraft:black_concrete",
        "minecraft:obsidian",
        "minecraft:coal_block",
        "minecraft:black_wool",
        "minecraft:black_terracotta",
        "minecraft:black_glazed_terracotta",
        "minecraft:deepslate"
    ]
    
    gold_count = len(gold_blocks)
    black_count = len(black_blocks)
    
    # Iterate over the bounding square
    for x in range(0 - radius, radius + 1):
        for z in range(0 - radius, radius + 1):
            # Calculate distance from center
            dist = sqrt(x * x + z * z)
            
            # Only place blocks within the circle
            if dist <= radius:
                # Calculate angle for floral pattern
                angle = atan2(z, x)
                
                # Create an elegant multi-layered floral pattern
                # Main pattern: 8 petals with varying amplitude based on distance
                petal_wave = sin(8 * angle)
                
                # Secondary pattern: inner rings for complexity
                ring_wave = sin(dist * 0.3)
                
                # Tertiary pattern: subtle spiral effect
                spiral_effect = sin(4 * angle + dist * 0.15)
                
                # Combined pattern value
                pattern_val = petal_wave * 0.5 + ring_wave * 0.25 + spiral_effect * 0.25
                
                # Determine if this is gold or black (floral)
                # Center is always gold for a nice sun-like effect
                if dist < 8:
                    is_gold = True
                elif dist < 15:
                    # Inner region: simpler petal pattern
                    is_gold = petal_wave > 0
                elif dist < 35:
                    # Middle region: combined pattern
                    is_gold = pattern_val > 0.1
                else:
                    # Outer region: more intricate with ring influence
                    outer_pattern = sin(12 * angle) * 0.6 + ring_wave * 0.4
                    is_gold = outer_pattern > 0
                
                # Add some randomized edge variation for organic feel
                edge_dist = radius - dist
                if edge_dist < 3:
                    noise = random()
                    if noise < 0.3:
                        # Flip is_gold (RRS doesn't support 'not' operator)
                        if is_gold:
                            is_gold = False
                        else:
                            is_gold = True
                
                # === LAYER 1: Solid blocks ===
                if is_gold:
                    # Random gold block selection
                    idx = randint(0, gold_count)
                    if idx >= gold_count:
                        idx = gold_count - 1
                    block_type = gold_blocks[idx]
                    Block(block_type, pos=(x, 0, z))
                    
                    # === LAYER 2: Yellow stained glass on top ===
                    Block("minecraft:yellow_stained_glass", pos=(x, 1, z))
                else:
                    # Random black block selection
                    idx = randint(0, black_count)
                    if idx >= black_count:
                        idx = black_count - 1
                    block_type = black_blocks[idx]
                    Block(block_type, pos=(x, 0, z))
                    
                    # === LAYER 2: Black stained glass on top ===
                    Block("minecraft:black_stained_glass", pos=(x, 1, z))

# Instantiate the grand gold circle with radius 50
grand_circle = GoldCircleWithFloralPattern(50)
export(grand_circle)

print("Gold circle with floral pattern created!")
print("Radius: 50 blocks")
print("Layers: 2 (solid base + stained glass top)")
