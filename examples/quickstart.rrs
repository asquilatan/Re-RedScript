# Welcome to Re-RedScript (RRS)!
# This is a basic module definition.

module House(width, height, depth):
    # Create the floor
    for x in range(width):
        for z in range(depth):
            Block("minecraft:oak_planks", pos=(x, 0, z))
    
    # Create pillars at corners
    for y in range(height):
        Block("minecraft:oak_log", pos=(0, y, 0))
        Block("minecraft:oak_log", pos=(width - 1, y, 0))
        Block("minecraft:oak_log", pos=(0, y, depth - 1))
        Block("minecraft:oak_log", pos=(width - 1, y, depth - 1))

# Instantiate the house
my_house = House(5, 4, 5)

# Export the module to .litematic
export(my_house)
