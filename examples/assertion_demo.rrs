# Assertion Demo for Re-RedScript (RRS)
# Shows how to use assert() to compare structures

module Structure1():
    Block("minecraft:stone", pos=(0, 0, 0))
    Block("minecraft:piston", pos=(0, 1, 0), facing="north")

module Structure2():
    Block("minecraft:stone", pos=(0, 0, 0))
    Block("minecraft:piston", pos=(0, 1, 0), facing="north")

module Structure3():
    Block("minecraft:stone", pos=(0, 0, 0))
    Block("minecraft:piston", pos=(0, 1, 0), facing="south")  # Different facing!

# Create instances
s1 = Structure1()
s2 = Structure2()
s3 = Structure3()

# Assert that s1 and s2 match on "id" and "facing"
assert(s1, s2, "id", "facing")
print("s1 and s2 match!")

# This would fail because s3 has different facing:
# assert(s1, s3, "facing")

# Export the structure
export(s1)
